-- Тот же дек, но решателю запрещено сходиться: TUNING даёт одну итерацию
-- Ньютона и запрещает срезать шаг (TSMINZ = TSMAXZ), закачка на два порядка
-- выше отбора. Flow принимает несошедшийся шаг и завершается кодом 0 —
-- ровно тот случай, ради которого статус читается из лога, а не из кода
-- возврата. Требует --enable-tuning=true, иначе TUNING игнорируется.
RUNSPEC
TITLE
  MINI RUNNER FIXTURE NO CONVERGENCE
DIMENS
 5 5 2 /
OIL
WATER
METRIC
START
 1 'JAN' 2020 /
WELLDIMS
 2 10 1 2 /
TABDIMS
 1 1 20 20 /
UNIFOUT

GRID
INIT
DX
 50*100 /
DY
 50*100 /
DZ
 50*10 /
TOPS
 25*2000 /
PORO
 50*0.2 /
PERMX
 50*100 /
PERMY
 50*100 /
PERMZ
 50*10 /

PROPS
SWOF
 0.2 0.0 1.0 0.0
 1.0 1.0 0.0 0.0 /
PVTW
 250 1.0 4.0E-5 0.5 0.0 /
PVCDO
 250 1.05 1.0E-4 2.0 0.0 /
DENSITY
 850 1000 1.0 /
ROCK
 250 5.0E-5 /

SOLUTION
EQUIL
 2000 250 2100 0 1500 0 1 1 0 /

SUMMARY
WBHP
/
WLPT
/
WOPT
/
WWIT
/

SCHEDULE
WELSPECS
 'PROD' 'G1' 1 1 2000 'OIL' /
 'INJ'  'G1' 5 5 2000 'WATER' /
/
COMPDAT
 'PROD' 1 1 1 2 'OPEN' 1* 1* 0.2 /
 'INJ'  5 5 1 2 'OPEN' 1* 1* 0.2 /
/
TUNING
 30 30 30 /
 /
 1 1 /
WCONPROD
 'PROD' 'OPEN' 'LRAT' 3* 100 1* 50 /
/
WCONINJE
 'INJ' 'WATER' 'OPEN' 'RATE' 100000 1* 4000 /
/
TSTEP
 10*30 /
END
