-- Настоящий двухфазный дек на 27 ячеек и 2 PVT-региона: приёмка ResponseLoader
-- требует восстановления WOMT/WOMR из COPT/COPR разных плотностей на
-- настоящем прогоне Flow, не выдумки. MULTI вскрывает оба региона (k=1 -> 1,
-- k=3 -> 2). PROD2 намеренно не может достичь уставки LRAT=500 при пределе
-- ячейки — упирается в BHP (WMCTL 4->7 на настоящем прогоне), затем явно
-- глушится вторым WCONPROD (WMCTL -> 0) — покрывает оба нерейтовых кода.
RUNSPEC
TITLE
  PVT RESPONSE LOADER FIXTURE
DIMENS
 3 3 3 /
OIL
WATER
METRIC
START
 1 'JAN' 2020 /
WELLDIMS
 3 10 1 3 /
TABDIMS
 2 2 20 20 /
UNIFOUT

GRID
INIT
DX
 27*100 /
DY
 27*100 /
DZ
 27*10 /
TOPS
 9*2000 /
PORO
 27*0.2 /
PERMX
 27*100 /
PERMY
 27*100 /
PERMZ
 27*10 /

PROPS
SWOF
 0.2 0.0 1.0 0.0
 1.0 1.0 0.0 0.0 /
 0.2 0.0 1.0 0.0
 1.0 1.0 0.0 0.0 /
PVTW
 250 1.0 4.0E-5 0.5 0.0 /
 250 1.0 4.0E-5 0.5 0.0 /
PVCDO
 250 1.05 1.0E-4 2.0 0.0 /
 250 1.05 1.0E-4 2.0 0.0 /
DENSITY
 800 1000 1.0 /
 850 1000 1.0 /
ROCK
 250 5.0E-5 /
 250 5.0E-5 /

REGIONS
PVTNUM
 9*1 9*1 9*2 /
SATNUM
 9*1 9*1 9*2 /

SOLUTION
EQUIL
 2000 250 2100 0 1500 0 1 1 0 /

SUMMARY
WBHP
/
WTHP
/
WLPT
/
WLPR
/
WWIT
/
WWIR
/
WEFF
/
WMCTL
/
COPT
 'MULTI' 2 2 1 /
 'MULTI' 2 2 3 /
 'PROD2' 1 1 1 /
 'INJ'   3 3 1 /
/
COPR
 'MULTI' 2 2 1 /
 'MULTI' 2 2 3 /
 'PROD2' 1 1 1 /
 'INJ'   3 3 1 /
/

SCHEDULE
WELSPECS
 'MULTI' 'G1' 2 2 2000 'OIL' /
 'PROD2' 'G1' 1 1 2000 'OIL' /
 'INJ'   'G1' 3 3 2000 'WATER' /
/
COMPDAT
 'MULTI' 2 2 1 3 'OPEN' 1* 1* 0.2 /
 'PROD2' 1 1 1 1 'OPEN' 1* 1* 0.2 /
 'INJ'   3 3 1 1 'OPEN' 1* 1* 0.2 /
/
WCONPROD
 'MULTI' 'OPEN' 'LRAT' 3* 50 1* 50 /
 'PROD2' 'OPEN' 'LRAT' 3* 500 1* 50 /
/
WCONINJE
 'INJ' 'WATER' 'OPEN' 'RATE' 100 1* 400 /
/
TSTEP
 30 30 /
WCONPROD
 'PROD2' 'SHUT' 'LRAT' 3* 500 1* 50 /
/
TSTEP
 30 /
END
